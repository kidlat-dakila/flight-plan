{
  "name": "backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/backend/src",
  "projectType": "application",
  "tags": [
    "type:app",
    "platform:node"
  ],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "platform": "node",
        "outputPath": "dist/apps/backend",
        "format": [
          "cjs"
        ],
        "bundle": true,
        "main": "apps/backend/src/main.ts",
        "tsConfig": "apps/backend/tsconfig.build.json",
        "assets": [
          {
            "input": "plugin",
            "glob": "**/*",
            "output": "plugin"
          },
          {
            "input": "packages/configurations/src",
            "glob": "**/*.md",
            "output": "configurations"
          }
        ],
        "esbuildOptions": {
          "sourcemap": true,
          "outExtension": {
            ".js": ".js"
          },
          "define": {
            "IS_DEVELOPMENT_BUILD": "false"
          }
        },
        "thirdParty": false,
        "excludeFromExternal": [
          "@agntn/forges",
          "@natoboram/bitbucket.ts"
        ]
      },
      "configurations": {
        "development": {
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".js"
            },
            "define": {
              "IS_DEVELOPMENT_BUILD": "true"
            }
          }
        },
        "production": {
          "esbuildOptions": {
            "sourcemap": false,
            "outExtension": {
              ".js": ".js"
            },
            "define": {
              "IS_DEVELOPMENT_BUILD": "false"
            }
          }
        },
        "package": {
          "outputPath": "dist/package/backend",
          "thirdParty": true,
          "metafile": true,
          "external": [
            "tree-sitter",
            "tree-sitter-html",
            "tree-sitter-python",
            "tree-sitter-typescript",
            "@napi-rs/keyring",
            "jsonc-parser"
          ],
          "esbuildOptions": {
            "sourcemap": false,
            "outExtension": {
              ".js": ".js"
            },
            "define": {
              "IS_DEVELOPMENT_BUILD": "false"
            },
            "banner": {
              "js": "#!/usr/bin/env node"
            },
            "outfile": "dist/package/backend/main.js"
          }
        }
      },
      "dependsOn": [
        "^build",
        {
          "projects": [
            "frontend"
          ],
          "target": "build-published"
        }
      ]
    },
    "package": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/package"
      ],
      "options": {
        "parallel": false,
        "commands": [
          "nx run backend:build:package",
          "nx run frontend:build-app",
          "jiti tools/npm-package/index.ts"
        ]
      }
    },
    "prune-lockfile": {
      "dependsOn": [
        "build"
      ],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/pnpm-workspace.yaml",
        "{workspaceRoot}/package.json",
        {
          "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
        }
      ],
      "outputs": [
        "{workspaceRoot}/dist/apps/backend/package.json",
        "{workspaceRoot}/dist/apps/backend/pnpm-lock.yaml",
        "{workspaceRoot}/dist/apps/backend/pnpm-workspace.yaml",
        "{workspaceRoot}/dist/apps/backend/patches",
        "{workspaceRoot}/dist/apps/backend/local_path_modules"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": [
        "build"
      ],
      "cache": true,
      "outputs": [
        "{workspaceRoot}/dist/apps/backend/workspace_modules"
      ],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": [
        "prune-lockfile",
        "copy-workspace-modules"
      ],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": [
        "build"
      ],
      "options": {
        "buildTarget": "backend:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "backend:build:development"
        },
        "production": {
          "buildTarget": "backend:build:production"
        }
      }
    },
    "dev": {
      "continuous": true,
      "executor": "@nx/js:node",
      "dependsOn": [
        {
          "projects": [
            "frontend"
          ],
          "target": "build-published"
        }
      ],
      "options": {
        "buildTarget": "backend:build:development",
        "runBuildTargetDependencies": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        {
          "externalDependencies": [
            "typescript"
          ]
        }
      ],
      "outputs": [
        "{workspaceRoot}/dist/out-tsc/{projectRoot}"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "tsc --build tsconfig.json"
      }
    }
  }
}
