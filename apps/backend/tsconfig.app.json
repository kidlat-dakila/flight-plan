{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc/apps/backend/app",
    "types": [
      "node"
    ],
    "rootDir": "src"
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx"
  ],
  "references": [
    {
      "path": "../../packages/configurations/tsconfig.lib.json"
    },
    {
      "path": "../../packages/codegraph/tsconfig.lib.json"
    },
    {
      "path": "../../packages/git-forge/tsconfig.lib.json"
    },
    {
      "path": "../../tools/playground-fixtures/tsconfig.lib.json"
    }
  ]
}
