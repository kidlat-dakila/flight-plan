{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "rootDir": "../..",
    "paths": {
      "@/*": [
        "./src/*",
        "../../packages/codegraph/src/*",
        "../../packages/configurations/src/*",
        "../../packages/git-forge/src/*",
        "../../packages/reviewed-marks/src/*",
        "../../tools/playground-fixtures/src/*"
      ],
      "@flightplan/configurations": [
        "../../packages/configurations/src/index.ts"
      ],
      "@flightplan/codegraph": [
        "../../packages/codegraph/src/index.ts"
      ],
      "@flightplan/git-forge": [
        "../../packages/git-forge/src/index.ts"
      ],
      "@flightplan/playground-fixtures": [
        "../../tools/playground-fixtures/src/index.ts"
      ],
      "@flightplan/reviewed-marks": [
        "../../packages/reviewed-marks/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "../../packages/configurations/src/**/*.ts",
    "../../packages/codegraph/src/**/*.ts",
    "../../packages/git-forge/src/**/*.ts",
    "../../packages/reviewed-marks/src/**/*.ts",
    "../../tools/playground-fixtures/src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/__tests__/**",
    "../../packages/configurations/src/**/*.spec.ts",
    "../../packages/codegraph/src/**/*.spec.ts",
    "../../packages/codegraph/src/**/__tests__/**",
    "../../packages/git-forge/src/**/*.spec.ts",
    "../../packages/git-forge/src/**/__tests__/**",
    "../../packages/reviewed-marks/src/**/__tests__/**",
    "../../tools/playground-fixtures/src/**/*.spec.ts",
    "../../tools/playground-fixtures/src/**/__tests__/**"
  ],
  "references": [
    {
      "path": "../../packages/configurations/tsconfig.lib.json"
    },
    {
      "path": "../../packages/codegraph/tsconfig.lib.json"
    },
    {
      "path": "../../packages/git-forge/tsconfig.lib.json"
    },
    {
      "path": "../../tools/playground-fixtures/tsconfig.lib.json"
    },
    {
      "path": "../../packages/reviewed-marks/tsconfig.lib.json"
    }
  ]
}
