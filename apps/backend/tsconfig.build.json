{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "rootDir": "../.."
  },
  "include": [
    "src/**/*.ts",
    "../../packages/configurations/src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/__tests__/**",
    "../../packages/configurations/src/**/*.spec.ts"
  ],
  "references": [
    {
      "path": "../../packages/configurations/tsconfig.lib.json"
    }
  ]
}
