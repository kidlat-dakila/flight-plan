{
  "compilerOptions": {
    "jsx": "react-jsx",
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "types": [
      "vite/client",
      "vitest"
    ],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@flightplan/ui/lib/*": [
        "../../packages/ui/src/lib/*"
      ],
      "@flightplan/ui/*": [
        "../../packages/ui/src/components/*"
      ],
      "@flightplan/backend/router": [
        "../backend/src/server/trpc/router.ts"
      ],
      "@flightplan/reviewed-marks": [
        "../../packages/reviewed-marks/src/index.ts"
      ]
    }
  },
  "files": [],
  "include": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ],
  "extends": "../../tsconfig.base.json"
}
