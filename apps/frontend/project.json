{
  "name": "frontend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/frontend/src",
  "projectType": "application",
  "tags": [
    "type:app",
    "platform:browser"
  ],
  "targets": {
    "dev": {
      "dependsOn": [
        {
          "projects": [
            "backend"
          ],
          "target": "dev"
        }
      ],
      "options": {
        "command": "until nc -z localhost 3000; do sleep 0.2; done; portless --name flightplan --app-port 4200 vite",
        "env": {
          "PORTLESS_PORT": "443",
          "PORTLESS_SYNC_HOSTS": "0"
        }
      }
    },
    "build-published": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^default"
      ],
      "outputs": [
        "{workspaceRoot}/dist/apps/published-review"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "vite build --config vite.published.config.mts"
      }
    },
    "build-app": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^default"
      ],
      "outputs": [
        "{workspaceRoot}/dist/apps/frontend"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "vite build"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        {
          "externalDependencies": [
            "typescript"
          ]
        }
      ],
      "outputs": [
        "{workspaceRoot}/dist/out-tsc/{projectRoot}"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "tsc --build tsconfig.json"
      }
    }
  }
}
