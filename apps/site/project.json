{
  "name": "site",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/site/src",
  "projectType": "application",
  "tags": [
    "type:app",
    "platform:browser"
  ],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "{projectRoot}",
        "command": "astro dev"
      },
      "dependsOn": [
        "watch-demo",
        "copy-docs-media"
      ]
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/packages/docs/src/**/*",
        {
          "externalDependencies": [
            "astro",
            "@astrojs/starlight",
            "@astrojs/markdown-satteri"
          ]
        }
      ],
      "outputs": [
        "{workspaceRoot}/dist/apps/site"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "astro build"
      },
      "dependsOn": [
        "build-demo",
        "copy-docs-media"
      ]
    },
    "preview": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": [
        "build"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "astro preview"
      }
    },
    "vercel-output": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "outputs": [
        "{workspaceRoot}/dist/apps/site-vercel"
      ],
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": false,
        "commands": [
          "rm -rf dist/apps/site-vercel",
          "mkdir -p dist/apps/site-vercel/.vercel/output",
          "cp apps/site/vercel/config.json dist/apps/site-vercel/.vercel/output/config.json",
          "cp -R dist/apps/site dist/apps/site-vercel/.vercel/output/static"
        ]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/apps/frontend/src/**/*",
        "{workspaceRoot}/apps/backend/src/**/*",
        "{workspaceRoot}/packages/*/src/**/*",
        {
          "externalDependencies": [
            "astro",
            "@astrojs/starlight",
            "@astrojs/check",
            "typescript"
          ]
        }
      ],
      "options": {
        "cwd": "{projectRoot}",
        "commands": [
          "astro check",
          "tsc -p demo/tsconfig.json"
        ],
        "parallel": false
      },
      "dependsOn": [
        "build"
      ]
    },
    "capture-screenshots": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "bash capture/capture-screenshots.sh"
      }
    },
    "record-hero": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "bash capture/record-hero.sh"
      }
    },
    "record-trace": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "bash capture/record-trace.sh"
      }
    },
    "record-blast": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "bash capture/record-blast.sh"
      }
    },
    "record-walkthrough": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "bash capture/record-walkthrough.sh"
      }
    },
    "record-docs": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "bash capture/record-docs.sh"
      }
    },
    "build-demo-data": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/demo/data/**/*",
        "{workspaceRoot}/tools/playground-fixtures/test-cases/demo-*/**/*",
        "{workspaceRoot}/tools/playground-fixtures/src/**/*",
        "{workspaceRoot}/packages/codegraph/src/**/*",
        "{workspaceRoot}/packages/configurations/src/**/*",
        {
          "externalDependencies": [
            "esbuild",
            "devalue"
          ]
        }
      ],
      "outputs": [
        "{projectRoot}/public/demo-data"
      ],
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": false,
        "commands": [
          "esbuild apps/site/demo/data/write-demo-data.ts --bundle --platform=node --format=esm --packages=external --tsconfig=apps/backend/tsconfig.build.json --outfile=dist/tools/site-demo/write-demo-data.mjs --log-level=warning",
          "node dist/tools/site-demo/write-demo-data.mjs tools/playground-fixtures/test-cases apps/site/public/demo-data"
        ]
      }
    },
    "build-demo": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": [
        "build-demo-data"
      ],
      "inputs": [
        "{projectRoot}/demo/**/*",
        "{workspaceRoot}/apps/frontend/src/**/*",
        "{workspaceRoot}/apps/frontend/public/logo.svg",
        "{workspaceRoot}/apps/backend/src/**/*",
        "{workspaceRoot}/packages/*/src/**/*",
        {
          "externalDependencies": [
            "vite",
            "react",
            "@tanstack/react-router",
            "@trpc/client",
            "@trpc/server"
          ]
        }
      ],
      "outputs": [
        "{projectRoot}/public/demo-app",
        "{projectRoot}/public/logo.svg"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "parallel": false,
        "commands": [
          "vite build --config demo/vite.config.mts --logLevel warn",
          "cp ../frontend/public/logo.svg public/logo.svg"
        ]
      }
    },
    "watch-demo": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": [
        "build-demo-data"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "parallel": false,
        "commands": [
          "cp ../frontend/public/logo.svg public/logo.svg",
          "vite build --config demo/vite.config.mts --watch --logLevel warn"
        ]
      }
    },
    "sync-types": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/packages/docs/src/**/*",
        {
          "externalDependencies": [
            "astro",
            "@astrojs/starlight"
          ]
        }
      ],
      "outputs": [
        "{projectRoot}/.astro"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "astro sync"
      }
    },
    "eslint:lint": {
      "dependsOn": [
        "sync-types"
      ]
    },
    "copy-docs-media": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/packages/docs/media/**/*"
      ],
      "outputs": [
        "{projectRoot}/public/docs-media"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "parallel": false,
        "commands": [
          "rm -rf public/docs-media",
          "cp -R ../../packages/docs/media public/docs-media"
        ]
      }
    }
  },
  "implicitDependencies": [
    "docs"
  ]
}
