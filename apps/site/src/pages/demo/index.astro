---
import { demoHrefOf, readDemoEntries, type DemoEntry } from "../../components/demo-index"
import FrameworkIcon from "../../components/FrameworkIcon.astro"
import SiteLayout from "../../layouts/SiteLayout.astro"

const PAGE_TITLE = "Flight Plan demo: pick a repository"
const PAGE_DESCRIPTION = "Open the Flight Plan review page for a real pull request, with reviewers, comment threads and a chat with the agent, right in your browser."

const FRAMEWORK_NAMES: Readonly<Record<string, string>> = { react: "React", vue: "Vue" }
const LINE_COLORS = ["var(--demo-line-blue)", "var(--demo-line-green)", "var(--demo-line-violet)", "var(--demo-line-magenta)"]

const frameworkNameOf = (entry: DemoEntry): string =>
  FRAMEWORK_NAMES[entry.meta.mainFramework] ?? entry.meta.mainFramework

const countLabelOf = (count: number, singular: string, plural: string): string => `${String(count)} ${count === 1 ? singular : plural}`

const entries = await readDemoEntries()
---

<SiteLayout title={PAGE_TITLE} description={PAGE_DESCRIPTION}>
  <div class="page-column demo-index">
    <header class="demo-intro">
      <h1>See a review in action.</h1>
      <p>
        Pick a repository. Each demo opens the real Flight Plan review page for one pull request, with reviewers, comment threads and a chat
        with the agent. It all runs in your browser, so comment, mark code as reviewed or submit a review as you like.
      </p>
    </header>

    <ol class="demo-list">
      {
        entries.map((entry, index) => (
          <li class="demo-row" style={`--line: ${LINE_COLORS[index % LINE_COLORS.length]}`}>
            <a class="demo-link" href={demoHrefOf(entry)}>
              <span class="framework-mark"><FrameworkIcon framework={entry.meta.mainFramework} fallbackLetter={frameworkNameOf(entry).charAt(0)} /></span>
              <span class="demo-heading">
                <span class="demo-framework">{frameworkNameOf(entry)}</span>
                <span class="demo-packages">{entry.meta.packages.map((name) => <span class="demo-package">{name}</span>)}</span>
              </span>
              <span class="demo-pull-request">
                <span class="demo-slug">{entry.story.repository.forgeSlug} #{entry.story.pullRequest.number}</span>
                <span class="demo-title">{entry.pullRequestTitle}</span>
                <span class="demo-facts">
                  {countLabelOf(entry.story.reviewers.length, "reviewer", "reviewers")}  •  {countLabelOf(entry.story.threads.length, "comment thread", "comment threads")}  •  by {entry.story.pullRequest.author}
                </span>
              </span>
              <span class="demo-open">
                Open the demo
                <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</SiteLayout>

<style>
  .demo-index {
    --demo-line-blue: oklch(0.51 0.2 262);
    --demo-line-green: oklch(0.51 0.13 160);
    --demo-line-violet: oklch(0.5 0.2 295);
    --demo-line-magenta: oklch(0.52 0.2 0);
    padding-block: 5rem 6rem;
  }

  @media (prefers-color-scheme: dark) {
    .demo-index {
      --demo-line-blue: oklch(0.72 0.15 262);
      --demo-line-green: oklch(0.74 0.15 160);
      --demo-line-violet: oklch(0.73 0.15 295);
      --demo-line-magenta: oklch(0.73 0.17 0);
    }
  }

  .demo-intro {
    max-width: 44rem;
    padding-bottom: 3rem;
  }

  h1 {
    font-size: clamp(2.75rem, 1.5rem + 3.4vw, 4.5rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .demo-intro p {
    max-width: 58ch;
    margin-top: 1.5rem;
    font-size: 1.1875rem;
    line-height: 1.75rem;
  }

  .demo-list {
    list-style: none;
  }

  .demo-row {
    border-top: 2px solid var(--frame);
  }

  .demo-row:last-child {
    border-bottom: 1px solid var(--border);
  }

  .demo-link {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 15rem) minmax(0, 1fr) auto;
    gap: 0.5rem 1.5rem;
    align-items: center;
    padding: 1.75rem 0.75rem 1.75rem 0;
    text-decoration: none;
    transition: background-color 180ms ease-out;
  }

  .demo-link:hover {
    background: var(--muted);
  }

  .framework-mark {
    display: inline-flex;
    justify-self: center;
  }

  .demo-heading,
  .demo-pull-request {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .demo-framework {
    color: var(--line);
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 2rem;
    letter-spacing: -0.02em;
  }

  .demo-packages,
  .demo-slug {
    color: var(--muted-ink);
    font-family: var(--mono);
    font-size: 0.8125rem;
    line-height: 1.25rem;
  }

  .demo-title {
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.5rem;
  }

  .demo-facts {
    color: var(--muted-ink);
    font-size: 0.875rem;
    line-height: 1.25rem;
    white-space: pre-wrap;
  }

  .demo-packages {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.9rem;
  }

  .demo-package {
    white-space: nowrap;
  }

  .demo-open {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 2.25rem;
    padding: 0 0.9rem;
    border-radius: 0.375rem;
    background: var(--amber);
    color: var(--amber-ink);
    font-size: 0.875rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .demo-open svg {
    width: 1rem;
    height: 1rem;
    transition: transform 180ms ease-out;
  }

  .demo-link:hover .demo-open svg {
    transform: translateX(3px);
  }

  @media (max-width: 47.99rem) {
    .demo-link {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      padding-right: 0;
    }

    .demo-pull-request,
    .demo-open {
      grid-column: 2;
    }

    .demo-open {
      justify-self: start;
      margin-top: 0.5rem;
    }
  }
</style>
