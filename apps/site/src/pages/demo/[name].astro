---
import { DEMO_APP_URL, DEMO_DATA_URL, readDemoEntries, type DemoEntry } from "../../components/demo-index"

interface Props {
  readonly entry: DemoEntry
  readonly names: readonly string[]
}

export const getStaticPaths = async () => {
  const entries = await readDemoEntries()
  const names = entries.map((entry) => entry.name)
  return entries.map((entry) => ({ params: { name: entry.name }, props: { entry, names } }))
}

const { entry, names } = Astro.props
const pageTitle = `${entry.story.repository.forgeSlug} #${String(entry.story.pullRequest.number)} • Flight Plan demo`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href={`${DEMO_APP_URL}/app.css`} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div id="demo-root" data-demo={entry.name} data-demos={JSON.stringify(names)} data-data-url={DEMO_DATA_URL}></div>
    <a class="demo-exit" href="/demo/">Demo <span aria-hidden="true">•</span> Other repositories</a>
    <script type="module" src={`${DEMO_APP_URL}/app.js`}></script>
  </body>
</html>

<style is:global>
  .demo-exit {
    position: fixed;
    left: 1rem;
    bottom: 1rem;
    z-index: 60;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2rem;
    padding: 0 0.75rem;
    border-radius: 0.375rem;
    background: oklch(0.218 0 0);
    color: oklch(0.97 0 0);
    font: 700 0.8125rem "Inter Variable", ui-sans-serif, system-ui, sans-serif;
    text-decoration: none;
  }

  .demo-exit span {
    color: oklch(0.76 0 0);
  }
</style>
