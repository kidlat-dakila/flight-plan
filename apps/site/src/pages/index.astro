---
import FaqSection from "../components/FaqSection.astro"
import FeatureSection from "../components/FeatureSection.astro"
import InstallCommand from "../components/InstallCommand.astro"
import FeatureVideo from "../components/FeatureVideo.astro"
import HeroMedia from "../components/HeroMedia.astro"
import Screenshot from "../components/Screenshot.astro"
import {
  BLAST_POSTER,
  BLAST_VIDEOS,
  CHANGE_OVERVIEW_POSTER,
  CHANGE_OVERVIEW_VIDEOS,
  CUSTOMIZE_SHOT,
  EXPLAIN_SHOT,
  SPOTLIGHT_SHOT,
  TRACE_POSTER,
  TRACE_VIDEOS,
  FILTERS_POSTER,
  FILTERS_VIDEOS,
  TOOLTIPS_POSTER,
  TOOLTIPS_VIDEOS,
  WAYPOINTS_POSTER,
  WAYPOINTS_VIDEOS,
} from "../components/review-screenshots"
import SiteLayout from "../layouts/SiteLayout.astro"

const PAGE_TITLE = "Flight Plan: review pull requests with ease"
const PAGE_DESCRIPTION = "An offline-first code review tool that helps you understand and navigate the changes in a pull request. See what changed, how it runs and what it can break before you read the diff, then let your coding agent explain each part."
const DEMO_HREF = "/demo/"
const FEATURE_IMAGE_SIZES = "(min-width: 64rem) 52rem, 100vw"

const LOCAL_FACTS = [
  { term: "~/.flightplan", detail: "Every review and every setting lives in this one directory on your machine." },
  { term: "Nothing in your repository", detail: "Flight Plan never writes into the code you review." },
  { term: "Sent only when you say", detail: "Comments go to your forge when you submit them, and a Flight Plan leaves your machine only when you publish it." },
] as const
---

<SiteLayout title={PAGE_TITLE} description={PAGE_DESCRIPTION}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="page-column hero-column">
      <div class="hero-copy">
        <h1 id="hero-title">Review pull&nbsp;requests with&nbsp;ease using <span class="brand-name">Flight&nbsp;Plan</span>.</h1>
        <p class="hero-lede">
          An <strong class="lede-emphasis">offline-first</strong> code review tool that helps you understand and navigate the changes in a pull request. See what changed, how it
          runs and what it can break before you read the diff, built on your machine with no model. When you want the why, your coding agent explains each part and flags
          potential bugs.
        </p>
        <div class="hero-actions">
          <InstallCommand />
          <p class="demo-line">or <a class="quiet-link" href={DEMO_HREF}>try our demo to see it firsthand</a>!</p>
        </div>
      </div>
    </div>
    <HeroMedia />
  </section>

  <div class="page-column">
    <FeatureSection
      id="change-overview"
      title="Take in the whole change first."
      subtitle="Every changed code block, sorted by the kind of code it is."
      summary="Spot the new page, the components it renders and the state behind them before you open a file. The Change Overview puts each changed code block in a row with others of its kind and marks it added, modified or deleted. Flight Plan builds it from the code with no agent, and a card with a waypoint takes you straight to its code."
      isFlipped={false}
    >
      <FeatureVideo poster={CHANGE_OVERVIEW_POSTER} videos={CHANGE_OVERVIEW_VIDEOS} sizes={FEATURE_IMAGE_SIZES} />
    </FeatureSection>

    <FeatureSection
      id="trace-flow"
      title="See how the change runs."
      subtitle="From the first trigger to the changed line, on one board."
      summary="Follow the behaviour without jumping between files. Flight Plan draws the path from the syntax trees, from what starts the code through each function it passes to the line you changed, and tags each card with the kind of code it is. Your agent can label each step in plain words."
      isFlipped={true}
    >
      <FeatureVideo poster={TRACE_POSTER} videos={TRACE_VIDEOS} sizes={FEATURE_IMAGE_SIZES} />
    </FeatureSection>

    <FeatureSection
      id="blast"
      title="Find what breaks before you merge."
      subtitle="The blast radius, including files the diff never shows."
      summary="Catch trouble in code the pull request never touched while you are still reviewing it. Flight Plan maps every file the change reaches through its imports, and your agent can check each one for what breaks or behaves differently."
      isFlipped={false}
    >
      <FeatureVideo poster={BLAST_POSTER} videos={BLAST_VIDEOS} sizes={FEATURE_IMAGE_SIZES} />
    </FeatureSection>

    <FeatureSection
      id="waypoints"
      title="See the risk on the line that causes it."
      subtitle="Each part of the change explained, risks included."
      summary="Know where to slow down before you start reading. Flight Plan marks each changed block of code as a waypoint, and your agent explains what it adds or changes, right above its lines. When it finds a risk, it says what could happen, traces how it gets there and shows you the fix."
      isFlipped={true}
    >
      <FeatureVideo poster={WAYPOINTS_POSTER} videos={WAYPOINTS_VIDEOS} sizes={FEATURE_IMAGE_SIZES} />
    </FeatureSection>

    <FeatureSection
      id="spotlight"
      title="Start with the code you care about."
      subtitle="Your topics and the core of the change, marked on the waypoints."
      summary="See at a glance which parts of a change touch what matters to you. Pick your topics in setup, such as API requests or security, and Flight Plan marks every waypoint and code block that touches one with Spotlight. Your agent marks the core changes, the parts the branch is built around, and says why. Pick the Most important first order and the walkthrough starts with them."
      isFlipped={false}
    >
      <Screenshot light={SPOTLIGHT_SHOT.light} dark={SPOTLIGHT_SHOT.dark} alt={SPOTLIGHT_SHOT.alt} sizes={FEATURE_IMAGE_SIZES} />
    </FeatureSection>

    <FeatureSection
      id="filters"
      title="Read only the parts you came for."
      subtitle="The walkthrough, narrowed to the waypoints you want to check."
      summary="Go straight to the components and the UI state, or to the code your agent flagged. Flight Plan sorts every waypoint by the kind of code it changes and by whether that code was added, modified or removed. Pick what you want and the walkthrough hides the rest."
      isFlipped={true}
    >
      <FeatureVideo poster={FILTERS_POSTER} videos={FILTERS_VIDEOS} sizes={FEATURE_IMAGE_SIZES} />
    </FeatureSection>

    <FeatureSection
      id="tooltips"
      title="Look up any name without leaving the diff."
      subtitle="Where each name in the code is defined, and where it is used."
      summary="Follow the code without opening another tab. Hover a name and Flight Plan shows where it comes from. An exported function lists the files that use it, and a variable shows the line that defines it."
      isFlipped={false}
    >
      <FeatureVideo poster={TOOLTIPS_POSTER} videos={TOOLTIPS_VIDEOS} sizes={FEATURE_IMAGE_SIZES} />
    </FeatureSection>

    <FeatureSection
      id="explain"
      title="Ask for the why when you need it."
      subtitle="Your agent explains the parts you pick, when you pick them."
      summary={`Spend your agent's time on the code you want explained. Every review opens already built, with short hints from Flight Plan on the parts nobody has explained yet, such as "Adds a component." Press G and your agent explains that line and checks it for issues, or press Ctrl+G for its whole code block. To have it explain the whole review, pick Explain this review in the ⚙ menu and choose the parts it writes.`}
      isFlipped={true}
    >
      <Screenshot light={EXPLAIN_SHOT.light} dark={EXPLAIN_SHOT.dark} alt={EXPLAIN_SHOT.alt} sizes={FEATURE_IMAGE_SIZES} />
    </FeatureSection>

    <FeatureSection
      id="customize"
      title="Explanations written your way."
      subtitle="Pick a preset, or tune every prompt yourself."
      summary="Don't like how your agent writes? No problem. Get short notes, or explanations for someone new to the code. Every part your agent writes has its own prompt, from the overall writing style down to how a single waypoint is worded, and you can rewrite any of them. Start from one of the four presets that ship with Flight Plan and duplicate it to make it yours."
      isFlipped={false}
    >
      <Screenshot light={CUSTOMIZE_SHOT.light} dark={CUSTOMIZE_SHOT.dark} alt={CUSTOMIZE_SHOT.alt} sizes={FEATURE_IMAGE_SIZES} />
    </FeatureSection>

    <FaqSection />
    <section class="closing" aria-labelledby="closing-title">
      <div class="closing-copy">
        <h2 id="closing-title">Your next review, on your machine.</h2>
        <p>
          Flight Plan reads TypeScript, JavaScript, Python and Vue, from local git or from GitHub, GitLab and Bitbucket. Add Claude Code, Codex or Cursor when you want each change
          explained and checked for bugs. It needs Node.js 22 or later.
        </p>
      </div>
      <dl class="local-facts">
        {
          LOCAL_FACTS.map((fact) => (
            <div>
              <dt>{fact.term}</dt>
              <dd>{fact.detail}</dd>
            </div>
          ))
        }
      </dl>
      <InstallCommand id="install" />
    </section>
  </div>
</SiteLayout>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: max(38rem, calc(100svh - 3.5rem));
    overflow: hidden;
  }

  .hero-column {
    position: relative;
    z-index: 1;
    padding-block: 5rem 6rem;
  }

  .hero-copy {
    max-width: max(27.5rem, calc(clamp(3rem, 1.5rem + 3.4vw, 4.5rem) * 7.1));
  }

  h1 {
    font-size: clamp(3rem, 1.5rem + 3.4vw, 4.5rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .brand-name {
    color: var(--amber-text);
  }

  .lede-emphasis {
    font-weight: 700;
  }

  .hero-lede {
    max-width: 36ch;
    margin: 1.75rem 0 2rem;
    font-size: 1.1875rem;
    line-height: 1.75rem;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.1rem;
  }








  .demo-line {
    color: var(--muted-ink);
    font-size: 0.9375rem;
  }

  .demo-line .quiet-link {
    color: var(--ink);
  }

  .closing {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 3rem 4rem;
    align-items: end;
    padding-block: 7rem 6rem;
  }

  .closing h2 {
    font-size: clamp(2.5rem, 1.75rem + 3vw, 4rem);
    line-height: 1;
    letter-spacing: -0.04em;
    max-width: 14ch;
  }

  .closing-copy p {
    max-width: 52ch;
    margin-top: 1.25rem;
    font-size: 1.125rem;
    line-height: 1.7rem;
  }

  .local-facts {
    grid-column: 1 / -1;
    grid-row: 2;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem 3rem;
    padding-top: 1.5rem;
    border-top: 2px solid var(--frame);
  }

  .local-facts dt {
    margin-bottom: 0.35rem;
    font-weight: 700;
  }

  .local-facts div:first-child dt {
    font-family: var(--mono);
    font-size: 0.94em;
  }

  .local-facts dd {
    color: var(--muted-ink);
    font-size: 0.9375rem;
    line-height: 1.45rem;
  }

  .closing :global(#install) {
    grid-column: 2;
    grid-row: 1;
    justify-self: end;
  }


  @media (max-width: 63.99rem) {
    .hero {
      display: block;
      min-height: 0;
    }

    .hero-column {
      padding-block: 3.5rem 0;
    }

    .hero-copy {
      max-width: 40rem;
    }

    .hero-lede {
      max-width: 52ch;
    }

  }

  @media (max-width: 63.99rem) {
    .closing {
      grid-template-columns: minmax(0, 1fr);
      padding-block: 4.5rem;
    }

    .local-facts {
      grid-row: auto;
      grid-template-columns: minmax(0, 1fr);
    }

    .closing :global(#install) {
      grid-column: 1;
      grid-row: auto;
      justify-self: start;
    }
  }

</style>
