---
import type { ImageMetadata } from "astro"
import { getImage } from "astro:assets"
import { HERO_POSTER, HERO_VIDEOS } from "./review-screenshots"

const POSTER_SIZES = "100vw"
const POSTER_WIDTHS = [960, 1440, 1920]
const DARK_SCHEME = "(prefers-color-scheme: dark)"

const optimise = (image: ImageMetadata) => getImage({ src: image, format: "webp", widths: POSTER_WIDTHS, sizes: POSTER_SIZES })

const [lightPoster, darkPoster] = await Promise.all([optimise(HERO_POSTER.light), optimise(HERO_POSTER.dark)])
---

<div class="hero-media">
  <picture>
    <source media={DARK_SCHEME} srcset={darkPoster.srcSet.attribute} sizes={POSTER_SIZES} type="image/webp" />
    <img
      class="hero-poster"
      src={lightPoster.src}
      srcset={lightPoster.srcSet.attribute}
      sizes={POSTER_SIZES}
      alt={HERO_POSTER.alt}
      width={HERO_POSTER.light.width}
      height={HERO_POSTER.light.height}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </picture>
  <video class="hero-video" muted loop playsinline preload="none" aria-hidden="true" tabindex="-1">
    <source src={HERO_VIDEOS.dark.webm} type="video/webm" media={DARK_SCHEME} />
    <source src={HERO_VIDEOS.dark.mp4} type="video/mp4" media={DARK_SCHEME} />
    <source src={HERO_VIDEOS.light.webm} type="video/webm" />
    <source src={HERO_VIDEOS.light.mp4} type="video/mp4" />
  </video>
</div>

<style>
  .hero-media {
    --hero-height: max(38rem, calc(100svh - 3.5rem));
    --headline-size: clamp(3rem, 1.5rem + 3.4vw, 4.5rem);
    --copy-width: max(27.5rem, calc(var(--headline-size) * 7.1));
    --copy-edge: calc(max(0px, (100vw - var(--measure)) / 2 - var(--gutter)) + var(--gutter) + var(--copy-width));
    --frame-rail: calc(var(--hero-height) * 0.313);
    --media-start: calc(var(--copy-edge) + 3rem - var(--frame-rail));
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-poster,
  .hero-video {
    position: absolute;
    top: 0;
    left: var(--media-start);
    width: calc(100% - var(--media-start));
    height: 100%;
    object-fit: cover;
    object-position: left top;
  }

  .hero-video {
    opacity: 0;
    transition: opacity 600ms var(--ease-out);
  }

  .hero-video.is-playing {
    opacity: 1;
  }

  .hero-media::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, var(--paper) 0, var(--paper) calc(var(--copy-edge) + 1rem), color-mix(in oklch, var(--paper) 60%, transparent) calc(var(--copy-edge) + 2.5rem), transparent calc(var(--copy-edge) + 5rem)),
      linear-gradient(to top, var(--paper) 0%, transparent 9rem);
    pointer-events: none;
  }

  @media (max-width: 63.99rem) {
    .hero-media {
      position: relative;
      inset: auto;
      height: 26rem;
      margin-top: 2.5rem;
      overflow: hidden;
    }

    .hero-poster {
      left: 0;
      width: 100%;
      object-position: 45% top;
    }

    .hero-video {
      display: none;
    }

    .hero-media::after {
      background: linear-gradient(to top, var(--paper) 0%, transparent 5rem);
    }
  }
</style>

<script>
  import { playVideo, prefersReducedMotion } from "./looping-video"

  const wideScreen = window.matchMedia("(min-width: 64rem)")

  document.querySelectorAll<HTMLVideoElement>(".hero-media .hero-video").forEach((video) => {
    if (wideScreen.matches && !prefersReducedMotion()) void playVideo(video)
  })
</script>
