---
interface Props {
  readonly framework: string
  readonly fallbackLetter: string
}

const { framework, fallbackLetter } = Astro.props
---

{
  framework === "react" ? (
    <svg class="framework-icon" viewBox="-11.5 -10.23 23 20.46" aria-hidden="true">
      <circle r="2.05" fill="#61dafb" />
      <g stroke="#61dafb" stroke-width="1" fill="none">
        <ellipse rx="11" ry="4.2" />
        <ellipse rx="11" ry="4.2" transform="rotate(60)" />
        <ellipse rx="11" ry="4.2" transform="rotate(120)" />
      </g>
    </svg>
  ) : framework === "vue" ? (
    <svg class="framework-icon" viewBox="0 0 32 28" aria-hidden="true">
      <path d="M0 0h6l10 17.3L26 0h6L16 27.7z" fill="#41b883" />
      <path d="M6 0h5l5 8.7L21 0h5L16 17.3z" fill="#35495e" />
    </svg>
  ) : (
    <span class="framework-letter" aria-hidden="true">{fallbackLetter}</span>
  )
}

<style>
  .framework-icon {
    width: 2.25rem;
    height: 2.25rem;
  }

  .framework-letter {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--line);
    color: var(--paper);
    font-size: 0.8125rem;
    font-weight: 700;
  }
</style>
