staged_files=$(git diff --cached --name-only --diff-filter=ACMRD)

if [ -n "$staged_files" ]; then
  changed_files="$staged_files"
else
  changed_files=$( (git diff --name-only --diff-filter=ACMRD; git ls-files --others --exclude-standard) | sort -u)
fi

if [ -z "$changed_files" ]; then
  exit 0
fi

nx affected -t eslint:lint typecheck --files="$(printf '%s\n' "$changed_files" | paste -sd, -)"

if printf '%s\n' "$changed_files" | grep -qE '^eslint(\.base)?\.config\.ts$'; then
  eslint eslint.base.config.ts eslint.config.ts
fi
