{
  "compileOnSave": false,
  "compilerOptions": {
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "module": "Preserve",
    "lib": [
      "ES2022"
    ],
    "skipLibCheck": true,
    "strict": true,
    "paths": {
      "@flightplan/ui/lib/*": [
        "./packages/ui/src/lib/*"
      ],
      "@flightplan/ui/*": [
        "./packages/ui/src/components/*"
      ],
      "@flightplan/configurations": [
        "./packages/configurations/src/index.ts"
      ],
      "@flightplan/backend/router": [
        "./apps/backend/src/server/trpc/router.ts"
      ]
    },
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "out",
    "src"
  ]
}
