{
  "name": "flight-plan",
  "description": "Read a pull request as an ordered walkthrough beside its code, written by your assistant through MCP tools.",
  "version": "0.1.5",
  "scripts": {
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js && pnpm run build:webview",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "check-types": "tsc --noEmit -p src/api && tsc --noEmit -p src/lib && tsc --noEmit -p src/ui",
    "lint": "eslint .",
    "test": "vitest run",
    "build:webview": "vite build --config src/ui/vite.config.ts",
    "watch:webview": "vite build --watch --config src/ui/vite.config.ts",
    "test:all": "vitest run",
    "harness": "vite --config src/ui/vite.config.ts --port 5199 --strictPort --host 127.0.0.1",
    "dev": "nx run-many -t dev -p frontend backend",
    "dev:api": "node tools/dev.mjs --api-only"
  },
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@eslint-react/eslint-plugin": "^5.23.2",
