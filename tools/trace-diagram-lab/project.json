{
  "name": "trace-diagram-lab",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/trace-diagram-lab/src",
  "projectType": "application",
  "tags": [
    "type:lab"
  ],
  "targets": {
    "dev": {
      "options": {
        "command": "portless --name trace-diagram-lab.flightplan --app-port 4410 vite",
        "env": {
          "PORTLESS_PORT": "443",
          "PORTLESS_SYNC_HOSTS": "0"
        }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        {
          "externalDependencies": [
            "typescript"
          ]
        }
      ],
      "outputs": [
        "{workspaceRoot}/dist/out-tsc/{projectRoot}"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "tsc --build tsconfig.json"
      }
    },
    "snapshot": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{projectRoot}",
        "command": "vitest run cases playgrounds --update && vitest run test-setup/__tests__/code-block-snapshots.spec.ts --update"
      }
    }
  }
}
