{
  "name": "reviewed-marks",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/reviewed-marks/src",
  "projectType": "library",
  "tags": [
    "type:reviewed-marks"
  ],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        {
          "externalDependencies": [
            "typescript"
          ]
        }
      ],
      "outputs": [
        "{workspaceRoot}/dist/out-tsc/{projectRoot}"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "tsc --build tsconfig.json"
      }
    }
  }
}
