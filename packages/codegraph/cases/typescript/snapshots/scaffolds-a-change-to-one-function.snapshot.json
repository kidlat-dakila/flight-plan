        },
        {
          "text": "",
          "mark": "context",
          "number": 3
        },
        {
          "text": "export function stockOf(sku: string): number {",
          "mark": "context",
          "number": 4
        },
        {
          "text": "  return stockBySku[sku] ?? 0;",
          "mark": "removed",
          "number": null
        },
        {
          "text": "  return (stockBySku[sku] ?? 0) - (heldBySku[sku] ?? 0);",
